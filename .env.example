# Copiez ce fichier en .env : docker compose le lit automatiquement.
PORT=8080
# Adresse publique (liens des e-mails, flux RSS, pages publiques)
PUBLIC_URL=http://localhost:8080
# Sauvegardes SQLite planifiées : intervalle en heures (1 à 720) et nombre de sauvegardes automatiques conservées (1 à 90)
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
# 1 pour autoriser les webhooks vers des adresses privées (réseau local)
WEBHOOK_ALLOW_PRIVATE=0
# Hors Docker, on peut aussi fixer : HOST, CORNICHON_DB (chemin de la base), BACKUP_DIR
